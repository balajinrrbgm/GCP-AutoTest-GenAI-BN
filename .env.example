# Environment variables for the Healthcare Test Case Generation System
# Copy this file to .env and fill in your actual values

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-1.5-pro

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/healthcare_testgen
REDIS_URL=redis://localhost:6379

# Firebase Configuration
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# API Configuration
API_HOST=localhost
API_PORT=8000
DEBUG=True
SECRET_KEY=your-super-secret-key-here

# ALM Integration Configuration
# Jira
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_USERNAME=your-jira-username
JIRA_API_TOKEN=your-jira-api-token

# Polarion
POLARION_BASE_URL=https://your-polarion-server.com
POLARION_USERNAME=your-polarion-username
POLARION_PASSWORD=your-polarion-password

# Azure DevOps
AZURE_DEVOPS_ORG=your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=your-personal-access-token

# Security Configuration
JWT_SECRET_KEY=your-jwt-secret-key
ENCRYPTION_KEY=your-32-byte-encryption-key

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# Monitoring and Logging
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn-if-using-sentry

# Feature Flags
ENABLE_AI_SUGGESTIONS=true
ENABLE_BATCH_PROCESSING=true
ENABLE_REAL_TIME_SYNC=true

# GDPR and Compliance
GDPR_ENABLED=true
DATA_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years for regulatory compliance

# Performance Configuration
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=300
CACHE_TTL_SECONDS=3600